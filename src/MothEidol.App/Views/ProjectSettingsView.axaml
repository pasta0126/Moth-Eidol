<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="using:MothEidol.App.Views"
             x:Class="MothEidol.App.Views.ProjectSettingsView">
    <ScrollViewer>
        <StackPanel Margin="0,16,16,16" Spacing="20" MaxWidth="900" HorizontalAlignment="Left">

            <StackPanel Spacing="8">
                <SelectableTextBlock Text="General" FontWeight="SemiBold" FontSize="16"
                           Foreground="{DynamicResource MothAccentBrush}" />
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <TextBox x:Name="NameBox" PlaceholderText="Project name" />
                    <Button x:Name="RenameButton" Grid.Column="1" Content="Rename" />
                </Grid>
                <CheckBox x:Name="EnabledCheck" Content="Monitor this project"
                          Foreground="{DynamicResource MothTextBrush}" />
                <SelectableTextBlock x:Name="GeneralError" TextWrapping="Wrap"
                           Foreground="{DynamicResource MothErrorBrush}" />
            </StackPanel>

            <StackPanel Spacing="8">
                <SelectableTextBlock Text="Log sources" FontWeight="SemiBold" FontSize="16"
                           Foreground="{DynamicResource MothAccentBrush}" />
                <Border Padding="12" CornerRadius="4" Background="{DynamicResource MothSurfaceBrush}">
                    <StackPanel Spacing="8">
                        <StackPanel Orientation="Horizontal" Spacing="16">
                            <RadioButton x:Name="FileRadio" GroupName="kind" IsChecked="True"
                                         Content="A file" Foreground="{DynamicResource MothTextBrush}" />
                            <RadioButton x:Name="FolderRadio" GroupName="kind"
                                         Content="A folder and a file name pattern (follows the newest match)"
                                         Foreground="{DynamicResource MothTextBrush}" />
                        </StackPanel>
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <TextBox x:Name="PathBox"
                                     PlaceholderText="Path to the log file or folder (local or a network share)" />
                            <Button x:Name="BrowseButton" Grid.Column="1" Content="Browse..." />
                        </Grid>
                        <TextBox x:Name="PatternBox" IsVisible="False"
                                 PlaceholderText="File name pattern, for example MyService*.log" />
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Button x:Name="AddButton" Content="Add source" Classes="accent" />
                            <SelectableTextBlock x:Name="SourceError" VerticalAlignment="Center" TextWrapping="Wrap"
                                       Foreground="{DynamicResource MothErrorBrush}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <SelectableTextBlock x:Name="NoSourcesText" Text="No sources yet." IsVisible="False"
                           Foreground="{DynamicResource MothTextMutedBrush}" />
                <ItemsControl x:Name="SourceList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="views:SourceRow">
                            <Grid ColumnDefinitions="110,*,Auto,Auto" ColumnSpacing="12" Margin="0,4">
                                <SelectableTextBlock Text="{Binding StatusText}" FontWeight="SemiBold"
                                           Foreground="{Binding StatusBrush}" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <SelectableTextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"
                                               Foreground="{DynamicResource MothTextBrush}" />
                                    <SelectableTextBlock Text="{Binding Detail}" FontSize="11" TextTrimming="CharacterEllipsis"
                                               Foreground="{DynamicResource MothTextMutedBrush}" />
                                </StackPanel>
                                <CheckBox Grid.Column="2" Content="Enabled" IsChecked="{Binding Enabled, Mode=OneWay}"
                                          Click="OnSourceEnabledClicked" Foreground="{DynamicResource MothTextBrush}" />
                                <Button Grid.Column="3" Content="Remove" Click="OnSourceRemoveClicked" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <StackPanel Spacing="8">
                <SelectableTextBlock Text="Alerts" FontWeight="SemiBold" FontSize="16"
                           Foreground="{DynamicResource MothAccentBrush}" />
                <SelectableTextBlock TextWrapping="Wrap" Foreground="{DynamicResource MothTextMutedBrush}"
                           Text="Errors always raise alerts and information never does. Choose what happens with warnings and how often alerts are delivered." />
                <CheckBox x:Name="WarningsCheck" Content="Raise alerts for warnings"
                          Foreground="{DynamicResource MothTextBrush}" />
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <ComboBox x:Name="ModeCombo" MinWidth="330">
                        <ComboBoxItem Content="Immediate, then group alerts during a cooldown" />
                        <ComboBoxItem Content="One summary per interval" />
                    </ComboBox>
                    <SelectableTextBlock x:Name="MinutesLabel" VerticalAlignment="Center"
                               Foreground="{DynamicResource MothTextMutedBrush}" />
                    <NumericUpDown x:Name="MinutesBox" Minimum="1" Maximum="1440" Increment="1"
                                   FormatString="0" Width="130" />
                </StackPanel>
                <SelectableTextBlock x:Name="AlertError" TextWrapping="Wrap"
                           Foreground="{DynamicResource MothErrorBrush}" />
            </StackPanel>

            <StackPanel Spacing="8">
                <SelectableTextBlock Text="Remove" FontWeight="SemiBold" FontSize="16"
                           Foreground="{DynamicResource MothErrorBrush}" />
                <Button x:Name="RemoveButton" Content="Remove this project" HorizontalAlignment="Left" />
                <StackPanel x:Name="ConfirmPanel" IsVisible="False" Spacing="8">
                    <SelectableTextBlock TextWrapping="Wrap" Foreground="{DynamicResource MothTextBrush}"
                               Text="This stops monitoring and deletes the project together with its sources. It cannot be undone." />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="ConfirmRemoveButton" Content="Yes, remove it" />
                        <Button x:Name="CancelRemoveButton" Content="Cancel" />
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
