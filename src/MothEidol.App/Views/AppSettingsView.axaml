<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="MothEidol.App.Views.AppSettingsView">
    <Grid Margin="24" RowDefinitions="*,Auto">
    <StackPanel Grid.Row="0" Spacing="12">
        <Button x:Name="BackButton" Content="&#x2190; Dashboard" HorizontalAlignment="Left" />
        <SelectableTextBlock Text="Settings" FontSize="28" FontWeight="Bold"
                   Foreground="{DynamicResource MothPrimaryBrush}" />
        <Separator Margin="0,8" Background="{DynamicResource MothBorderBrush}" />

        <CheckBox x:Name="AutostartCheck" Content="Start with my session"
                  Foreground="{DynamicResource MothTextBrush}" />
        <SelectableTextBlock x:Name="AutostartNote" TextWrapping="Wrap" IsVisible="False"
                   Foreground="{DynamicResource MothTextMutedBrush}" />

        <Separator Margin="0,8" Background="{DynamicResource MothBorderBrush}" />
        <SelectableTextBlock Text="Notification channels" FontWeight="SemiBold" FontSize="16"
                   Foreground="{DynamicResource MothAccentBrush}" />
        <SelectableTextBlock TextWrapping="Wrap" Foreground="{DynamicResource MothTextMutedBrush}"
                   Text="How Moth-Eidol tells you about alerts. Each channel can be switched on or off on its own." />
        <StackPanel x:Name="ChannelsPanel" Spacing="8" />

        <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,8,0,0">
            <SelectableTextBlock Text="Alert sound" VerticalAlignment="Center"
                       Foreground="{DynamicResource MothTextBrush}" />
            <ComboBox x:Name="SoundCombo" MinWidth="170" SelectedIndex="0">
                <ComboBoxItem Content="With sound" />
                <ComboBoxItem Content="Silent" />
            </ComboBox>
        </StackPanel>

        <CheckBox x:Name="SplashCheck" Content="Show the splash screen at startup" Margin="0,8,0,0"
                  Foreground="{DynamicResource MothTextBrush}" />

        <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,8,0,0">
            <SelectableTextBlock Text="Theme" VerticalAlignment="Center"
                       Foreground="{DynamicResource MothTextBrush}" />
            <ComboBox x:Name="ThemeCombo" MinWidth="170" SelectedIndex="0">
                <ComboBoxItem Content="Moth (dark)" />
                <ComboBoxItem Content="Vesper (light)" />
            </ComboBox>
        </StackPanel>

        <SelectableTextBlock Text="Closing this window keeps Moth-Eidol running in the tray. Use the tray menu to quit."
                   Foreground="{DynamicResource MothTextMutedBrush}"
                   TextWrapping="Wrap" Margin="0,8,0,0" />
    </StackPanel>

    <StackPanel Grid.Row="1" Spacing="4" VerticalAlignment="Bottom" Margin="0,16,0,0">
        <Separator Margin="0,0,0,8" Background="{DynamicResource MothBorderBrush}" />
        <TextBlock TextWrapping="Wrap" FontSize="12" HorizontalAlignment="Left"
                   Foreground="{DynamicResource MothTextMutedBrush}">
            <Run Text="I'm " /><Run Text="pasta0126" FontWeight="Bold" /><Run Text=", a developer from Barcelona who loves turning ideas into small tools you can click, explore and hopefully enjoy." />
        </TextBlock>
        <WrapPanel Orientation="Horizontal" HorizontalAlignment="Left">
            <TextBlock Text="If Moth-Eidol makes your day a little easier, you can&#160;" FontSize="12" LineHeight="18"
                       VerticalAlignment="Center" Foreground="{DynamicResource MothTextMutedBrush}" />
            <Button x:Name="CoffeeLink" FontSize="12" Height="18" MinHeight="0" Padding="0"
                    VerticalAlignment="Center" VerticalContentAlignment="Center"
                    Background="Transparent" BorderThickness="0" Cursor="Hand"
                    Foreground="{DynamicResource MothAccentBrush}">
                <TextBlock Text="buy me a coffee &#x2615;" FontSize="12" LineHeight="18" VerticalAlignment="Center" />
            </Button>
        </WrapPanel>
        <WrapPanel x:Name="AboutLinks" Orientation="Horizontal" ItemSpacing="14" LineSpacing="2" />
        <SelectableTextBlock x:Name="AboutNote" TextWrapping="Wrap" FontSize="12" IsVisible="False"
                   Foreground="{DynamicResource MothTextMutedBrush}" />
    </StackPanel>
    </Grid>
</UserControl>
