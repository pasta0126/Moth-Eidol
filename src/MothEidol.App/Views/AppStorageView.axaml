<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="MothEidol.App.Views.AppStorageView">
    <ScrollViewer>
        <StackPanel Margin="0,16,16,16" Spacing="20" MaxWidth="900" HorizontalAlignment="Left">

            <StackPanel Spacing="8">
                <Grid ColumnDefinitions="*,Auto">
                    <SelectableTextBlock Text="Local database" FontWeight="SemiBold" FontSize="16" VerticalAlignment="Center"
                               Foreground="{DynamicResource MothAccentBrush}" />
                    <Button x:Name="RefreshButton" Grid.Column="1" Content="Refresh" />
                </Grid>
                <SelectableTextBlock TextWrapping="Wrap" Foreground="{DynamicResource MothTextMutedBrush}"
                           Text="Everything Moth-Eidol keeps on this computer, for all projects. Each project removes its own history older than its retention; here you can also remove whole projects and anything left over." />
                <Border Padding="12" CornerRadius="4" Background="{DynamicResource MothSurfaceBrush}">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="24" RowSpacing="6" RowDefinitions="Auto,Auto,Auto,Auto">
                        <SelectableTextBlock Grid.Row="0" Text="Data folder" Foreground="{DynamicResource MothTextMutedBrush}" />
                        <SelectableTextBlock Grid.Row="0" Grid.Column="1" x:Name="FolderText" TextWrapping="Wrap" Foreground="{DynamicResource MothTextBrush}" />
                        <SelectableTextBlock Grid.Row="1" Text="Database file" Foreground="{DynamicResource MothTextMutedBrush}" />
                        <SelectableTextBlock Grid.Row="1" Grid.Column="1" x:Name="FileText" Foreground="{DynamicResource MothTextBrush}" />
                        <SelectableTextBlock Grid.Row="2" Text="Reclaimable space" Foreground="{DynamicResource MothTextMutedBrush}" />
                        <SelectableTextBlock Grid.Row="2" Grid.Column="1" x:Name="ReclaimableText" Foreground="{DynamicResource MothTextBrush}" />
                        <SelectableTextBlock Grid.Row="3" Text="All projects" Foreground="{DynamicResource MothTextMutedBrush}" />
                        <SelectableTextBlock Grid.Row="3" Grid.Column="1" x:Name="TotalText" Foreground="{DynamicResource MothTextBrush}" />
                    </Grid>
                </Border>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Name="CompactButton" Content="Compact database" />
                    <SelectableTextBlock VerticalAlignment="Center" TextWrapping="Wrap" Foreground="{DynamicResource MothTextMutedBrush}"
                               Text="Returns the free space to the disk. Nothing is removed." />
                </StackPanel>
                <SelectableTextBlock x:Name="BusyText" IsVisible="False" Text="Working… monitoring keeps running."
                           Foreground="{DynamicResource MothTextMutedBrush}" />
                <SelectableTextBlock x:Name="ResultText" TextWrapping="Wrap" Foreground="{DynamicResource MothTextBrush}" />
                <SelectableTextBlock x:Name="ErrorText" TextWrapping="Wrap" Foreground="{DynamicResource MothErrorBrush}" />
            </StackPanel>

            <StackPanel Spacing="8">
                <SelectableTextBlock Text="Projects" FontWeight="SemiBold" FontSize="16"
                           Foreground="{DynamicResource MothAccentBrush}" />
                <SelectableTextBlock TextWrapping="Wrap" Foreground="{DynamicResource MothTextMutedBrush}"
                           Text="Largest first. Projects that are disabled or have no sources but still hold events are marked: they are good candidates to clean up." />
                <StackPanel x:Name="ProjectsPanel" Spacing="8" />
            </StackPanel>

            <StackPanel Spacing="8">
                <SelectableTextBlock Text="Leftovers" FontWeight="SemiBold" FontSize="16"
                           Foreground="{DynamicResource MothAccentBrush}" />
                <SelectableTextBlock TextWrapping="Wrap" Foreground="{DynamicResource MothTextMutedBrush}"
                           Text="Data that belongs to no current project or source, and copies of a database that was found corrupt. Current projects are never touched." />
                <SelectableTextBlock x:Name="LeftoversText" TextWrapping="Wrap" Foreground="{DynamicResource MothTextBrush}" />
                <Button x:Name="LeftoversButton" Content="Remove leftovers" HorizontalAlignment="Left" />
                <StackPanel x:Name="LeftoversConfirm" IsVisible="False" Spacing="8">
                    <SelectableTextBlock x:Name="LeftoversConfirmText" TextWrapping="Wrap" Foreground="{DynamicResource MothTextBrush}" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="LeftoversYes" Content="Yes, remove them" />
                        <Button x:Name="LeftoversCancel" Content="Cancel" />
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
