<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="using:MothEidol.App.Views"
             x:Class="MothEidol.App.Views.EventsView">
    <Grid>
        <DockPanel x:Name="ListPanel" Margin="0,12,0,0">
            <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                <ComboBox x:Name="FilterCombo" MinWidth="170" SelectedIndex="0">
                    <ComboBoxItem Content="Pending only" />
                    <ComboBoxItem Content="All events" />
                </ComboBox>
                <SelectableTextBlock x:Name="SummaryText" Grid.Column="1" VerticalAlignment="Center"
                           Foreground="{DynamicResource MothTextMutedBrush}" />
                <Button x:Name="MarkAllButton" Grid.Column="2" Content="Mark all as seen" />
            </Grid>

            <SelectableTextBlock x:Name="EmptyText" DockPanel.Dock="Top" Margin="0,16,0,0" TextWrapping="Wrap"
                       Foreground="{DynamicResource MothTextMutedBrush}" />

            <ListBox x:Name="GroupList" Margin="0,12,0,0" Background="Transparent">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="views:EventGroupRow">
                        <Grid ColumnDefinitions="40,*,Auto,100,70,95,95" ColumnSpacing="12" Margin="0,5"
                              AttachedToVisualTree="OnGroupRowAttached" Background="Transparent"
                              ToolTip.Tip="{Binding LastSeenExact}">
                            <SelectableTextBlock Text="{Binding LevelText}" FontWeight="Bold" VerticalAlignment="Center"
                                       FontFamily="Menlo,Consolas,Monospace" Foreground="{Binding LevelBrush}" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                <SelectableTextBlock Text="{Binding Title}" FontWeight="{Binding TitleWeight}"
                                           TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource MothTextBrush}" />
                                <SelectableTextBlock Text="{Binding Location}" IsVisible="{Binding HasLocation}" FontSize="12"
                                           TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource MothAccentSoftBrush}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <Border IsVisible="{Binding IsNew}" CornerRadius="3" Padding="6,1"
                                        Background="{DynamicResource MothInfoBrush}">
                                    <SelectableTextBlock Text="NEW" FontSize="10" FontWeight="Bold"
                                               Foreground="{DynamicResource MothBgBrush}" />
                                </Border>
                                <Border IsVisible="{Binding IsRegressed}" CornerRadius="3" Padding="6,1"
                                        Background="{DynamicResource MothErrorBrush}">
                                    <SelectableTextBlock Text="REGRESSED" FontSize="10" FontWeight="Bold"
                                               Foreground="{DynamicResource MothTextBrush}" />
                                </Border>
                            </StackPanel>
                            <views:SparklineControl Grid.Column="3" Height="24" VerticalAlignment="Center"
                                                    Values="{Binding Series}" Brush="{Binding SeriesBrush}" />
                            <SelectableTextBlock Grid.Column="4" Text="{Binding CountText}" VerticalAlignment="Center"
                                       HorizontalAlignment="Right" Foreground="{DynamicResource MothTextMutedBrush}" />
                            <StackPanel Grid.Column="5" VerticalAlignment="Center">
                                <SelectableTextBlock Text="{Binding PendingText}" Foreground="{Binding PendingBrush}" />
                            </StackPanel>
                            <SelectableTextBlock Grid.Column="6" Text="{Binding LastSeenText}" VerticalAlignment="Center"
                                       FontSize="12" Foreground="{DynamicResource MothTextMutedBrush}" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <DockPanel x:Name="DetailPanel" IsVisible="False" Margin="0,12,0,0">
            <views:ViewActionsBar DockPanel.Dock="Top" Margin="0,0,0,6">
                <ToggleButton x:Name="DetailRawToggle" Content="Raw" />
                <CheckBox x:Name="DetailWrapCheck" Content="Word wrap" IsChecked="True" />
            </views:ViewActionsBar>
            <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="12">
                <Button x:Name="DetailBackButton" Content="&#x2190; Events" VerticalAlignment="Top" />
                <StackPanel Grid.Column="1" Spacing="3">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <SelectableTextBlock x:Name="DetailLevel" FontWeight="Bold" VerticalAlignment="Center"
                                   FontFamily="Menlo,Consolas,Monospace" />
                        <Border x:Name="NewBadge" IsVisible="False" CornerRadius="3" Padding="6,1"
                                Background="{DynamicResource MothInfoBrush}" VerticalAlignment="Center">
                            <SelectableTextBlock Text="NEW" FontSize="10" FontWeight="Bold"
                                       Foreground="{DynamicResource MothBgBrush}" />
                        </Border>
                        <Border x:Name="RegressedBadge" IsVisible="False" CornerRadius="3" Padding="6,1"
                                Background="{DynamicResource MothErrorBrush}" VerticalAlignment="Center">
                            <SelectableTextBlock Text="REGRESSED" FontSize="10" FontWeight="Bold"
                                       Foreground="{DynamicResource MothTextBrush}" />
                        </Border>
                    </StackPanel>
                    <SelectableTextBlock x:Name="DetailTitle" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap"
                               Foreground="{DynamicResource MothTextBrush}" />
                    <SelectableTextBlock x:Name="DetailLocation" Foreground="{DynamicResource MothAccentSoftBrush}" />
                    <SelectableTextBlock x:Name="DetailMeta" Foreground="{DynamicResource MothTextMutedBrush}" />
                </StackPanel>
                <Button x:Name="CopyButton" Grid.Column="2" Content="Copy summary" VerticalAlignment="Top" />
                <Button x:Name="DetailSeenButton" Grid.Column="3" Content="Mark as seen" Classes="accent"
                        VerticalAlignment="Top" />
            </Grid>

            <SelectableTextBlock x:Name="CopiedText" DockPanel.Dock="Top" Margin="0,6,0,0"
                       Foreground="{DynamicResource MothInfoBrush}" />

            <Border DockPanel.Dock="Top" Margin="0,12,0,0" Padding="12" CornerRadius="4"
                    Background="{DynamicResource MothSurfaceBrush}">
                <StackPanel Spacing="6">
                    <Grid ColumnDefinitions="*,Auto">
                        <SelectableTextBlock Text="Occurrences over time" FontWeight="SemiBold" VerticalAlignment="Center"
                                   Foreground="{DynamicResource MothAccentBrush}" />
                        <ComboBox x:Name="RangeCombo" Grid.Column="1" MinWidth="150" SelectedIndex="0">
                            <ComboBoxItem Content="Last 24 hours" />
                            <ComboBoxItem Content="Last 7 days" />
                        </ComboBox>
                    </Grid>
                    <views:SparklineControl x:Name="Timeline" Height="64" HorizontalAlignment="Stretch" />
                    <Grid ColumnDefinitions="*,Auto,*">
                        <SelectableTextBlock x:Name="AxisStart" FontSize="11"
                                   Foreground="{DynamicResource MothTextMutedBrush}" />
                        <SelectableTextBlock x:Name="PeakText" Grid.Column="1" FontSize="11"
                                   Foreground="{DynamicResource MothTextMutedBrush}" />
                        <SelectableTextBlock x:Name="AxisEnd" Grid.Column="2" FontSize="11" HorizontalAlignment="Right"
                                   Foreground="{DynamicResource MothTextMutedBrush}" />
                    </Grid>
                </StackPanel>
            </Border>

            <Grid Margin="0,12,0,0" ColumnDefinitions="300,12,*">
                <DockPanel>
                    <SelectableTextBlock x:Name="DetailNote" DockPanel.Dock="Top" Margin="0,0,0,6" TextWrapping="Wrap"
                               Foreground="{DynamicResource MothTextMutedBrush}" />
                    <ListBox x:Name="OccurrenceList" Background="{DynamicResource MothSurfaceBrush}"
                             BorderBrush="{DynamicResource MothBorderBrush}" BorderThickness="1">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="views:OccurrenceRow">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" Margin="0,3"
                                      ToolTip.Tip="{Binding Exact}" Background="Transparent"
                                      AttachedToVisualTree="OnOccurrenceRowAttached">
                                    <StackPanel>
                                        <SelectableTextBlock Text="{Binding Relative}" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource MothTextBrush}" />
                                        <SelectableTextBlock Text="{Binding Source}" FontSize="12" TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource MothTextMutedBrush}" />
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="Copy" VerticalAlignment="Center" Padding="8,2"
                                            ToolTip.Tip="Copy the context and the full message of this occurrence"
                                            Click="OnOccurrenceCopyClicked" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
                <ScrollViewer x:Name="DetailScroll" Grid.Column="2" HorizontalScrollBarVisibility="Auto">
                    <ContentControl x:Name="OccurrenceDetail" Margin="0,0,12,12">
                        <ContentControl.ContextMenu>
                            <ContextMenu>
                                <MenuItem x:Name="CopyAllItem" Header="Copy all (context and occurrence)" />
                            </ContextMenu>
                        </ContentControl.ContextMenu>
                    </ContentControl>
                </ScrollViewer>
                <TextBox x:Name="DetailRawBox" Grid.Column="2" IsVisible="False" Margin="0,0,0,12"
                         IsReadOnly="True" AcceptsReturn="True"
                         FontFamily="Menlo,Consolas,Monospace" FontSize="12"
                         Background="{DynamicResource MothSurfaceBrush}" Foreground="{DynamicResource MothTextBrush}"
                         BorderBrush="{DynamicResource MothBorderBrush}" BorderThickness="1" />
            </Grid>
        </DockPanel>
    </Grid>
</UserControl>
