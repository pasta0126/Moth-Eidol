<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="using:MothEidol.App.Views"
             x:Class="MothEidol.App.Views.DashboardView">
    <DockPanel Margin="24">
        <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto">
            <StackPanel>
                <TextBlock Text="MOTH-EIDOL" FontSize="28" FontWeight="Bold"
                           Foreground="{DynamicResource MothPrimaryBrush}" />
                <TextBlock Text="Projects" Foreground="{DynamicResource MothAccentSoftBrush}" />
            </StackPanel>
            <Button x:Name="SettingsButton" Grid.Column="1" Content="Settings" VerticalAlignment="Top" />
        </Grid>

        <Border x:Name="CreatePanel" DockPanel.Dock="Top" IsVisible="False" Margin="0,16,0,0" Padding="12"
                CornerRadius="4" Background="{DynamicResource MothSurfaceBrush}">
            <StackPanel Spacing="8">
                <TextBlock Text="Name of the new project" FontWeight="SemiBold"
                           Foreground="{DynamicResource MothAccentBrush}" />
                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                    <TextBox x:Name="NameBox" PlaceholderText="For example: Billing service" />
                    <Button x:Name="CreateButton" Grid.Column="1" Content="Create" Classes="accent" />
                    <Button x:Name="CancelButton" Grid.Column="2" Content="Cancel" />
                </Grid>
                <TextBlock x:Name="ErrorText" TextWrapping="Wrap"
                           Foreground="{DynamicResource MothErrorBrush}" />
            </StackPanel>
        </Border>

        <TextBlock x:Name="HintText" DockPanel.Dock="Top" Margin="0,16,0,0" IsVisible="False" TextWrapping="Wrap"
                   Text="No projects yet. Create one, then add the log folders it should follow."
                   Foreground="{DynamicResource MothTextMutedBrush}" />

        <ScrollViewer Margin="0,16,0,0">
            <ItemsControl x:Name="Tiles">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="views:TileModel">
                        <Button Click="OnTileClicked" Padding="0" Margin="0,0,16,16"
                                Background="Transparent" BorderThickness="0">
                            <Border Width="260" Height="120" CornerRadius="6" ClipToBounds="True"
                                    Background="{DynamicResource MothSurfaceBrush}"
                                    BorderBrush="{DynamicResource MothBorderBrush}" BorderThickness="1">
                                <Grid>
                                    <Grid IsVisible="{Binding IsProject}" ColumnDefinitions="6,*">
                                        <Border Background="{Binding StatusBrush}" />
                                        <StackPanel Grid.Column="1" Margin="14,12" Spacing="6">
                                            <TextBlock Text="{Binding Name}" FontSize="17" FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis"
                                                       Foreground="{DynamicResource MothTextBrush}" />
                                            <TextBlock Text="{Binding StatusText}" FontWeight="SemiBold"
                                                       Foreground="{Binding StatusBrush}" />
                                            <TextBlock Text="{Binding Detail}" FontSize="12"
                                                       TextTrimming="CharacterEllipsis"
                                                       Foreground="{DynamicResource MothTextMutedBrush}" />
                                        </StackPanel>
                                    </Grid>
                                    <StackPanel IsVisible="{Binding IsNew}" VerticalAlignment="Center"
                                                HorizontalAlignment="Center" Spacing="4">
                                        <TextBlock Text="+" FontSize="34" HorizontalAlignment="Center"
                                                   Foreground="{DynamicResource MothPrimaryBrush}" />
                                        <TextBlock Text="New project" HorizontalAlignment="Center"
                                                   Foreground="{DynamicResource MothAccentSoftBrush}" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</UserControl>
