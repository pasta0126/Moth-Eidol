<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="using:MothEidol.App.Views"
             x:Class="MothEidol.App.Views.ViewerView">
    <DockPanel Margin="16">
        <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="12">
            <ComboBox x:Name="SourceCombo" HorizontalAlignment="Stretch" PlaceholderText="Select a source" />
            <ComboBox x:Name="LevelCombo" Grid.Column="1" MinWidth="170" SelectedIndex="0">
                <ComboBoxItem Content="All levels" />
                <ComboBoxItem Content="Warning and above" />
                <ComboBoxItem Content="Error and above" />
            </ComboBox>
            <ToggleButton x:Name="PauseToggle" Grid.Column="2" Content="Pause auto-scroll" />
            <Button x:Name="ClearButton" Grid.Column="3" Content="Clear" />
            <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <TextBlock Text="Max lines" VerticalAlignment="Center"
                           Foreground="{DynamicResource MothTextMutedBrush}" />
                <NumericUpDown x:Name="MaxLinesBox" Minimum="100" Maximum="200000" Increment="500"
                               FormatString="0" Width="130" />
            </StackPanel>
            <TextBlock x:Name="ScrollStateText" Grid.Column="5" VerticalAlignment="Center" MinWidth="130"
                       Foreground="{DynamicResource MothTextMutedBrush}" />
        </Grid>

        <TextBlock x:Name="HintText" DockPanel.Dock="Top" Margin="0,12,0,0"
                   Foreground="{DynamicResource MothTextMutedBrush}" TextWrapping="Wrap" />

        <ListBox x:Name="LinesList" Margin="0,12,0,0"
                 Background="{DynamicResource MothSurfaceBrush}"
                 BorderBrush="{DynamicResource MothBorderBrush}" BorderThickness="1"
                 ScrollViewer.HorizontalScrollBarVisibility="Auto">
            <ListBox.Styles>
                <Style Selector="ListBoxItem">
                    <Setter Property="Padding" Value="6,1" />
                    <Setter Property="MinHeight" Value="0" />
                </Style>
            </ListBox.Styles>
            <ListBox.ItemTemplate>
                <DataTemplate x:DataType="views:EntryItem">
                    <StackPanel Orientation="Horizontal" Spacing="8" Background="Transparent"
                                Tapped="OnEntryTapped">
                        <TextBlock Text="{Binding Time}" FontFamily="Menlo,Consolas,Monospace" FontSize="12"
                                   Foreground="{DynamicResource MothTextMutedBrush}" />
                        <TextBlock Text="{Binding LevelText}" FontFamily="Menlo,Consolas,Monospace" FontSize="12"
                                   FontWeight="Bold" Foreground="{Binding LevelBrush}" />
                        <TextBlock Text="{Binding Text}" FontFamily="Menlo,Consolas,Monospace" FontSize="12"
                                   TextWrapping="NoWrap" Foreground="{DynamicResource MothTextBrush}" />
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</UserControl>
