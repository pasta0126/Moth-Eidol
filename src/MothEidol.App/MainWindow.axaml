<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="using:MothEidol.App.Views"
        x:Class="MothEidol.App.MainWindow"
        Icon="/Assets/app-icon.png"
        Title="Moth-Eidol"
        Width="1100" Height="720" MinWidth="720" MinHeight="460"
        Background="{DynamicResource MothBgBrush}"
        WindowStartupLocation="CenterScreen">
    <DockPanel>
    <Border DockPanel.Dock="Bottom" Margin="0,8,0,0"
            BorderBrush="{DynamicResource MothBorderBrush}"
            BorderThickness="0,1,0,0" Padding="24,8">
        <SelectableTextBlock x:Name="VersionText" FontSize="12"
                   Foreground="{DynamicResource MothTextMutedBrush}" />
    </Border>
    <Border x:Name="NoticeBanner" DockPanel.Dock="Top" IsVisible="False" Padding="12" Margin="16,16,16,0"
            CornerRadius="4" BorderThickness="1"
            Background="{DynamicResource MothSurfaceAltBrush}"
            BorderBrush="{DynamicResource MothWarningBrush}">
        <SelectableTextBlock x:Name="NoticeText" TextWrapping="Wrap"
                   Foreground="{DynamicResource MothTextBrush}" />
    </Border>
    <Grid>
        <views:DashboardView x:Name="Dashboard" />
        <views:ProjectView x:Name="ProjectScreen" IsVisible="False" />
        <views:ProjectWizardView x:Name="WizardScreen" IsVisible="False" />
        <views:AppSettingsView x:Name="SettingsScreen" IsVisible="False" />
    </Grid>
    </DockPanel>
</Window>
