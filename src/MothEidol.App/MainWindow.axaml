<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="MothEidol.App.MainWindow"
        Icon="/Assets/app-icon.png"
        Title="Moth-Eidol"
        Width="520" Height="320"
        Background="{DynamicResource MothBgBrush}"
        WindowStartupLocation="CenterScreen">
    <DockPanel>
    <Border DockPanel.Dock="Bottom"
            BorderBrush="{DynamicResource MothBorderBrush}"
            BorderThickness="0,1,0,0" Padding="24,8">
        <TextBlock x:Name="VersionText" FontSize="12"
                   Foreground="{DynamicResource MothTextMutedBrush}" />
    </Border>
    <StackPanel Margin="24" Spacing="12">
        <TextBlock Text="MOTH-EIDOL" FontSize="28" FontWeight="Bold"
                   Foreground="{DynamicResource MothPrimaryBrush}" />
        <TextBlock Text="System Observability Compound"
                   Foreground="{DynamicResource MothAccentSoftBrush}" />
        <Separator Margin="0,8" Background="{DynamicResource MothBorderBrush}" />

        <CheckBox x:Name="AutostartCheck" Content="Start with my session"
                  Foreground="{DynamicResource MothTextBrush}" />
        <TextBlock x:Name="AutostartNote" TextWrapping="Wrap" IsVisible="False"
                   Foreground="{DynamicResource MothTextMutedBrush}" />

        <TextBlock Text="Closing this window keeps Moth-Eidol running in the tray. Use the tray menu to quit."
                   Foreground="{DynamicResource MothTextMutedBrush}"
                   TextWrapping="Wrap" Margin="0,8,0,0" />
    </StackPanel>
    </DockPanel>
</Window>
