<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        The application's two themes. Both define the same Moth*Brush names, so no view knows which one is
        active; use these brushes everywhere and do not hard-code colors in views.

        Dark  = MOTH-EIDOL. Colors come from the moth artwork: near-black obsidian, amber/orange/copper/cream,
                one small turquoise accent.
                  Obsidiana #1D1511  Caoba #5B2D11  Cobre #9C5825  Ambar intenso #DF651D
                  Naranja polilla #F2932D  Oro suave #E6A15B  Dorado #FCC86E
                  Marfil calido #F8D69E  Blanco crema #FBF2DC  Turquesa #639B9D
        Light = VESPER. Warm ivory and cream backgrounds, deep navy as primary, gold as the accent.
                  Marfil #F5F0E7  Crema #FBF8F2  Beige #EDE5D9  Azul marino #202536  Dorado #C8923E
                Text colors are deepened to stay readable (4.5:1 or more) on the ivory and cream backgrounds;
                the palette's gold itself (2.4:1) is too light for text, so the accent brushes use a darker gold.

        The application picks one by setting its theme variant (Dark = Moth, Light = Vesper).
    -->
    <ResourceDictionary.ThemeDictionaries>

        <ResourceDictionary x:Key="Dark">
            <SolidColorBrush x:Key="MothBgBrush" Color="#1D1511" />
            <SolidColorBrush x:Key="MothSurfaceBrush" Color="#302017" />
            <SolidColorBrush x:Key="MothSurfaceAltBrush" Color="#5B2D11" />
            <SolidColorBrush x:Key="MothBorderBrush" Color="#724727" />
            <SolidColorBrush x:Key="MothPrimaryBrush" Color="#DF651D" />
            <SolidColorBrush x:Key="MothPrimaryHoverBrush" Color="#F2932D" />
            <SolidColorBrush x:Key="MothAccentBrush" Color="#FCC86E" />
            <SolidColorBrush x:Key="MothAccentSoftBrush" Color="#E6A15B" />
            <SolidColorBrush x:Key="MothTextBrush" Color="#FBF2DC" />
            <SolidColorBrush x:Key="MothTextMutedBrush" Color="#B08C64" />
            <SolidColorBrush x:Key="MothInfoBrush" Color="#639B9D" />
            <SolidColorBrush x:Key="MothWarningBrush" Color="#F2932D" />
            <SolidColorBrush x:Key="MothErrorBrush" Color="#DB2F0C" />
            <!-- Traffic light for project status (neutral uses MothTextMuted) -->
            <SolidColorBrush x:Key="MothStatusGreenBrush" Color="#5DBB63" />
            <SolidColorBrush x:Key="MothStatusYellowBrush" Color="#F2D14B" />
            <SolidColorBrush x:Key="MothStatusOrangeBrush" Color="#F28C28" />
            <SolidColorBrush x:Key="MothStatusRedBrush" Color="#E5432D" />
            <!-- Text selection: amber highlight -->
            <SolidColorBrush x:Key="TextControlSelectionHighlightColor" Color="#DF651D" />
        </ResourceDictionary>

        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="MothBgBrush" Color="#F5F0E7" />
            <SolidColorBrush x:Key="MothSurfaceBrush" Color="#FBF8F2" />
            <SolidColorBrush x:Key="MothSurfaceAltBrush" Color="#EDE5D9" />
            <SolidColorBrush x:Key="MothBorderBrush" Color="#DED5C8" />
            <SolidColorBrush x:Key="MothPrimaryBrush" Color="#202536" />
            <SolidColorBrush x:Key="MothPrimaryHoverBrush" Color="#3D4355" />
            <SolidColorBrush x:Key="MothAccentBrush" Color="#8A5E12" />
            <SolidColorBrush x:Key="MothAccentSoftBrush" Color="#6E5A3A" />
            <SolidColorBrush x:Key="MothTextBrush" Color="#22242B" />
            <SolidColorBrush x:Key="MothTextMutedBrush" Color="#65666D" />
            <SolidColorBrush x:Key="MothInfoBrush" Color="#2F6F73" />
            <SolidColorBrush x:Key="MothWarningBrush" Color="#9A5B00" />
            <SolidColorBrush x:Key="MothErrorBrush" Color="#B3261E" />
            <!-- Traffic light for project status (neutral uses MothTextMuted) -->
            <SolidColorBrush x:Key="MothStatusGreenBrush" Color="#2E7D32" />
            <SolidColorBrush x:Key="MothStatusYellowBrush" Color="#B8860B" />
            <SolidColorBrush x:Key="MothStatusOrangeBrush" Color="#C2570C" />
            <SolidColorBrush x:Key="MothStatusRedBrush" Color="#B3261E" />
            <!-- Text selection: navy highlight -->
            <SolidColorBrush x:Key="TextControlSelectionHighlightColor" Color="#202536" />
        </ResourceDictionary>

    </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>
