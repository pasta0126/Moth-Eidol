{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build",
      "type": "process",
      "command": "dotnet",
      "args": ["build", "${workspaceFolder}/src/MothEidol.App/MothEidol.App.csproj"],
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": "$msCompile"
    },
    {
      "label": "test",
      "type": "process",
      "command": "dotnet",
      "args": ["test", "${workspaceFolder}/MothEidol.slnx"],
      "group": "test",
      "problemMatcher": "$msCompile"
    },
    {
      "label": "run (script)",
      "type": "shell",
      "command": "${workspaceFolder}/scripts/run.sh",
      "windows": { "command": "${workspaceFolder}\\scripts\\run.cmd" },
      "isBackground": true,
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated" }
    }
  ]
}
